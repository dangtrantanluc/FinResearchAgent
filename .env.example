DATABASE_URL=postgresql://finresearch:finresearch@127.0.0.1:5433/finresearch
GEMINI_API_KEY=
# Mỗi dòng là danh sách model theo thứ tự thử; model đầu tiên trả lời được sẽ được dùng.
# Bậc miễn phí: 20 lượt gọi mỗi ngày cho mỗi model, không có hạn mức cho các model Pro.
# Mỗi báo cáo tốn 2 lượt (1 viết nháp, 1 kiểm tra), nên hai danh sách dùng các model khác nhau.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash
